-def coneFinInt (φ : (Fin n × Fin d → Fv F v) → ℂ) (k : UA σ X.J) (l : (AE F E)ˣ) (y : Fin n₁ × Fin d₁ → Fv F v) : ℂ :=
-  ev (locOp v (M.co.rho B.ψ (partFin v (u l))) (locOp v (om (k, 1)) φ)) y * (ν l : ℂ) * ((absE F E l : ℝ) : ℂ) ^ z
