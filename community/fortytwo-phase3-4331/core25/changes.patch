-  haveI : IsProbabilityMeasure μK := ⟨hK.2⟩
-  have e : ∀ k : KAt K (evFin F v), locOp v (om (k.1, 1)) φ = φ := fun k => locOp_eq hφ hφ (hfix k.1 k.2)
