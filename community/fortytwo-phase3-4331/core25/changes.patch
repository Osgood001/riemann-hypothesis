-theorem coneInfInt_lin (hψ : IsStd B.ψ) {k : UA σ X.J}
-    (hk : ∀ f : SInf F (Fin n × Fin d), ∃ f₁ : SInf F (Fin n × Fin d), Acts (evI F) (om (k, 1)) f f₁)
