+    have hc : 0 < c := Measure.addHaarScalarFactor_pos_of_isAddHaarMeasure μ ν
+    have e : μ = c • ν := Measure.isAddLeftInvariant_eq_smul μ ν
+    have hac : ν ≪ μ := by
+      rw [e]
+      exact Measure.absolutelyContinuous_smul (by exact_mod_cast hc.ne')
+    have hU' : IsAddFundamentalDomain (unipLattice E N r) U ν := hU.mono hac
+    refine ⟨(c : ℂ) * (a.toReal : ℂ), mul_ne_zero (by exact_mod_cast hc.ne') hvol, ?_⟩
+    funext g
+    change ∫ x in U, φ.1 (unip x * g) ∂μ = (c : ℂ) * (a.toReal : ℂ) * ((a.toReal : ℂ)⁻¹ * constantTerm r φ.1 g)
+    rw [constantTerm_eq_setIntegral hL hU' g]
+    conv_lhs => rw [e]
+    rw [Measure.restrict_smul, integral_smul_nnreal_measure, NNReal.smul_def, Complex.real_smul]
+    simp only [same_unip]
+    field_simp <;> rfl
+
 
 end PositivityTheory.Rg.Rs
 
