-  have hint : Integrable H (finiteIdeleMeasure K) := by
-    have hn := integrable_norm_finIntegrand (integralInd2_mem (K := K)) 1 hz
-    refine hn.mono' hcont.aestronglyMeasurable (Eventually.of_forall fun b ↦ ?_)
-    rw [hHT, awayOrderTerm]
