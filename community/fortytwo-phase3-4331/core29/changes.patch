-  have hsum := hasSum_integral_finiteIdeleMeasure_of_invariant hint hinv
-  have hL : HasSum (fun c : (FiniteAdeleRing (𝓞 K) K)ˣ ⧸ finiteIntegralUnits K ↦ H c.out)
