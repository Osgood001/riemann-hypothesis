-      hinv (by rw [hτ]; exact formalDegreeFactor_eq_prod ε lam) hZ
-  · have hUU := hU N ε lam ep0 h0 H σ w hdat hDS hw
-    have hexp : p * q = ((nPlus ε * nMinus ε : ℕ) : ℝ) := by push_cast; rfl
