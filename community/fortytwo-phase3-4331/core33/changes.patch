-    [InnerProductSpace ℂ H] (σ : Matrix (Fin N) (Fin N) ℂ → (H →L[ℂ] H)) (w : H),
-    TheoremThreeHypotheses C3 ε lam ep0 h0 → IsDS ε lam σ → w ≠ 0 →
-    ∃ Z : ℝ, 0 < Z ∧ Z ≤ (1 - ep0)⁻¹ ∧
-      1 / fdegOf ((D.s.cdScale N ε : ENNReal) • Formalism.REAL.muG ε) σ w ≤
