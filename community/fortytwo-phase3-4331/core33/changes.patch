-      idxSig D (D.host.g 0) (D.host.g 1) / idxPi D (D.host.g 0) (D.host.g 1) ∧
-    idxSig D (D.host.g 0) (D.host.g 1) / idxPi D (D.host.g 0) (D.host.g 1) ≤
-      (2 : ℝ) ^ (2 * D.R.f) * ((D.host.g 0 : ℝ) * (D.host.g 1 : ℝ)) ^
-        ((D.R.f : ℝ) * D.R.m * (2 * D.R.k + D.R.m - 1) / 2) := by
