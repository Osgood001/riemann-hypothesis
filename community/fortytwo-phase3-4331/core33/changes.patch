-        (Module.finrank ℂ (lowKSub ε lam σ) : ℝ) (cGr (nPlus ε) (nMinus ε)) c0 (lamAbs lam) hd hτp
-        (grassmannVolumeConst_pos _ _) hc0 hlp (by omega) hg hUU
