-def ratioH (D : D7) (M : ℕ) : ℝ :=
-  letI := D.host.cmStar
-  ((((M - 1).factorial : ℕ) : ℝ) * (D.host.v / Real.pi) ^ M) ^ D.R.f / Real.sqrt ((2 * D.host.v) ^ D.R.f) *
-    Formalism.HermitianLatticesTheory.lValEta D.host.E M
