  ∃ J : ℂ, ∀ z, IntegrableOn (translates z (kerSmall W Θ' g g₁)) (M.fd _) (M.ν _) →
    ∫ u in M.fd _, translates z (kerSmall W Θ' g g₁) u ∂M.ν _ = zdeg z * J := by
  intro _ hK _ _ _
  obtain ⟨C, H⟩ := GlobalTheory.RegAt.standing_all
  refine ⟨C, fun ε CF hCF => ?_⟩
  obtain ⟨x, hx⟩ := H ε CF hCF
  refine ⟨x, fun D large₂ he hlarge Γ _ _ Pl0 T A Ks _ _ _ R F hS => ?_⟩
  have hst := hx D large₂ he hlarge Γ Pl0 T A Ks R F hS
  intro G W _ B ρ _ t i j M hM Θ Θ' hΘ g g₁
  exact (GlobalTheory.ThetaRegularizationComparison.existsUnique_reg_const_of_slice_bound hK.smallThetaSliceBound
    hS.core.lev W B ρ t i j (hst G t) M hM Θ Θ' hΘ g g₁).exists
end GlobalTheory.SmallConst
