module

public import Mathlib.RepresentationTheory.Irreducible
public import Mathlib.LinearAlgebra.Span.Basic

@[expose] public section

namespace Bl.OrbitSpans

variable {K G V : Type*} [Field K] [Monoid G] [AddCommGroup V] [Module K V]
    (ρ : Representation K G V) (v : V)

/-- The subrepresentation generated by the translates of a single vector. -/
def orbitSpan : Subrepresentation ρ where
  toSubmodule := Submodule.span K (Set.range fun g => ρ g v)
  apply_mem_toSubmodule g := by
    apply (Submodule.span_le (p := (Submodule.span K _).comap (ρ g))).2
    rintro _ ⟨h, rfl⟩
    exact Submodule.subset_span ⟨g * h, by simp [map_mul]⟩

theorem mem_orbitSpan_self : v ∈ (orbitSpan ρ v).toSubmodule :=
  Submodule.subset_span ⟨1, by simp⟩

/-- Under the invariant-submodule dichotomy, every nonzero vector spans the representation
under translation. This form also applies when nontriviality is not given as an instance. -/
theorem span_eq_top_of_invariant
    (hirr : ∀ W : Submodule K V, (∀ g : G, ∀ w ∈ W, ρ g w ∈ W) → W = ⊥ ∨ W = ⊤)
    (hv : v ≠ 0) : Submodule.span K (Set.range fun g => ρ g v) = ⊤ := by
  let S := orbitSpan ρ v
  apply (hirr S.toSubmodule (fun g _ hw => S.apply_mem_toSubmodule g hw)).resolve_left
  intro h
  exact hv (show v ∈ (⊥ : Submodule K V) from h ▸ mem_orbitSpan_self ρ v)

theorem orbitSpan_eq_top [ρ.IsIrreducible] (hv : v ≠ 0) : orbitSpan ρ v = ⊤ := by
  apply (eq_bot_or_eq_top (orbitSpan ρ v)).resolve_left
  intro h
  exact hv (show v ∈ (⊥ : Subrepresentation ρ) from h ▸ mem_orbitSpan_self ρ v)

end Bl.OrbitSpans
